{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values of the observability chart",
  "description": "Refuses what would break the contract of the stack (Service names that the datasources and the smoke test use, ClusterIP only, no password in a values file, no Alertmanager or other extra Pods, Loki on its claim) and typos in the keys of this chart. The keys under fluent-bit, loki, prometheus and grafana are the official charts' own and are checked only where this chart depends on them.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Accepted only because the shared workflow always passes podAnnotations.checksum/app-env when the Secret observability-env is created (every service chart puts it on its Pods). This chart has no Pod of its own to carry it and an umbrella chart's top-level value does not reach a subchart, so it changes nothing: after a changed admin password, restart Grafana by hand (README, Deploy)"
    },
    "alerting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emailAddresses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^@\\s;]+@[^@\\s;]+\\.[^@\\s;]+$" },
          "description": "Not secrets. The SMTP user and password are, and come from the Secret observability-env"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "smokeTest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "pattern": "@sha256:[0-9a-f]{64}$", "description": "Pinned by digest" }
      },
      "required": ["image"]
    },
    "fluent-bit": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "const": "fluent-bit", "description": "The name that the NetworkPolicy of Loki admits" },
        "config": {
          "type": "object",
          "properties": {
            "outputs": { "type": "string", "pattern": "Name\\s+loki", "description": "The logs go to Loki" }
          }
        }
      }
    },
    "loki": {
      "type": "object",
      "properties": {
        "fullnameOverride": { "const": "loki", "description": "The Service loki:3100 that Fluent Bit, Grafana and the smoke test use" },
        "deploymentMode": { "const": "SingleBinary", "description": "One process (ADR-035)" },
        "loki": {
          "type": "object",
          "properties": {
            "auth_enabled": { "const": false, "description": "Fluent Bit and Grafana send no tenant header" },
            "storage": { "type": "object", "properties": { "type": { "const": "filesystem" } } }
          }
        },
        "singleBinary": {
          "type": "object",
          "properties": {
            "replicas": { "const": 1 },
            "service": { "type": "object", "properties": { "type": { "const": "ClusterIP" } } },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "const": true, "description": "Without a claim the logs are lost at every restart" },
                "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
              }
            }
          }
        },
        "ingress": { "type": "object", "properties": { "enabled": { "const": false } } },
        "gateway": { "type": "object", "properties": { "enabled": { "const": false } } }
      }
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "alertmanager": { "type": "object", "properties": { "enabled": { "const": false, "description": "Alerts are Grafana's (ADR-036)" } } },
        "prometheus-pushgateway": { "type": "object", "properties": { "enabled": { "const": false } } },
        "prometheus-node-exporter": { "type": "object", "properties": { "enabled": { "const": false } } },
        "kube-state-metrics": { "type": "object", "properties": { "enabled": { "const": false } } },
        "server": {
          "type": "object",
          "properties": {
            "fullnameOverride": { "const": "prometheus-server", "description": "The Service prometheus-server:80 that Grafana and the smoke test use" },
            "retention": { "type": "string", "pattern": "^[0-9]+[mhdwy]$", "description": "Short on purpose (README, Sizing)" },
            "service": { "type": "object", "properties": { "type": { "const": "ClusterIP" } } },
            "ingress": { "type": "object", "properties": { "enabled": { "const": false } } },
            "persistentVolume": {
              "type": "object",
              "properties": {
                "enabled": { "const": true },
                "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
              }
            }
          }
        }
      }
    },
    "grafana": {
      "type": "object",
      "description": "No adminPassword key: the password comes from the Secret named in admin.existingSecret",
      "not": { "required": ["adminPassword"] },
      "properties": {
        "fullnameOverride": { "const": "grafana", "description": "The Service grafana:80 that the smoke test uses" },
        "admin": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1, "description": "The Secret that the pipeline creates (observability-env)" }
          },
          "required": ["existingSecret"]
        },
        "service": { "type": "object", "properties": { "type": { "const": "ClusterIP" } } },
        "ingress": { "type": "object", "properties": { "enabled": { "const": false } } },
        "route": {
          "type": "object",
          "properties": { "main": { "type": "object", "properties": { "enabled": { "const": false } } } }
        },
        "envRenderSecret": { "type": "object", "maxProperties": 0, "description": "A value here would be kept in the release history; secrets come from the pipeline's Secret" }
      },
      "required": ["admin"]
    }
  }
}
